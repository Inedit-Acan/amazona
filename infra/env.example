# Copy to .env and adjust for local development.
# No real credentials belong here (Milestone 1 uses no real providers).

ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=amazona
POSTGRES_PASSWORD=amazona
POSTGRES_DB=amazona
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://amazona:amazona@localhost:5432/amazona

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
