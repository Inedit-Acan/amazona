# Copy to backend/.env and fill in real values there. NEVER commit backend/.env
# (it's gitignored) and never hardcode these values in source.

# development | test | demo | staging | production.
# staging y production exigen SIEMPRE token verificado en las rutas mutadoras,
# comprueban el rol y NO se creen el campo "actor" del cuerpo de la petición.
# Además el proceso se niega a arrancar si falta SUPABASE_URL/ANON_KEY o si
# CORS_ORIGINS apunta a localhost (Milestone 29, ADR 0007).
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase / PostgreSQL ---
# Project Settings -> Database -> Connection string (use the pooled "Transaction"
# connection string for the app; SQLAlchemy dialect prefix must stay
# postgresql+psycopg://). Project must be provisioned in the EU region.
DATABASE_URL=

# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security — never expose to the
# Control Center or any client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Redis (task/event coordination)
REDIS_URL=redis://localhost:6379/0

# --- Seguridad (Milestone 29) ---
# Fuerza la autenticación en los entornos locales. En staging/production se
# exige igualmente, valga lo que valga esto.
REQUIRE_AUTH=false

# Claim `aud` que emite tu proyecto de Supabase. El valor por defecto de
# Supabase Auth es "authenticated"; cámbialo solo si usas un GoTrue propio.
JWT_AUDIENCE=authenticated

# --- Proveedores externos (Milestone 30) ---
# Qué implementación respalda cada dominio: mock | sandbox | real.
# "mock" son fixtures deterministas: valen para desarrollo, demos y tests, y
# NUNCA como base de una decisión operativa. staging y production se niegan a
# arrancar con cualquiera de estos en "mock" (ADR 0008).
# Pedir un adaptador que no existe hace fallar el arranque con un mensaje claro
# en vez de caer en silencio al mock.
PRODUCT_INTELLIGENCE_PROVIDER=mock
SUPPLIERS_PROVIDER=mock
REGULATORY_PROVIDER=mock
ADS_PROVIDER=mock
MARKETPLACES_PROVIDER=mock

# --- Fuentes reales de Product Intelligence (Milestone 37, ADR 0015) ---
# Qué fuentes reales se usan y EN QUÉ ORDEN cuando el dominio está en "real" o
# "composite". El primero que da una señal de un tipo manda; los siguientes solo
# rellenan lo que falte. Una fuente que no existe aborta el arranque.
# Disponibles: wikimedia-pageviews, ebay-browse.
PRODUCT_INTELLIGENCE_REAL_SOURCES=["wikimedia-pageviews"]

# Ajustes por adaptador, cada uno en su espacio de nombres (doble guion bajo).
# El tope de peticiones existe por el arriendo de 60 s del runtime (ADR 0009):
# la investigación corre dentro de un trabajo y no puede acercarse a ese límite.
WIKIMEDIA__MONTHS=12
WIKIMEDIA__MAX_REQUESTS=8
WIKIMEDIA__TIMEOUT_SECONDS=6.0
# Si se pregunta a Wikimedia cómo se llama cada artículo en el idioma del mercado
# (Milestone 38, ADR 0016). Con esto en false, un mercado que no sea el del
# proyecto por defecto se queda SIN SEÑAL en vez de medir el artículo equivocado:
# preguntarle a es.wikipedia por «Air fryer» devuelve 404 (medido en el M36).
WIKIMEDIA__RESOLVE_LANGUAGES=true

# eBay Browse. Las claves son de un keyset de DESARROLLADOR GRATUITO: no hay nada
# que pagar y no hace falta cuenta de vendedor (usa el flujo de credenciales de
# cliente). Vacías por defecto; configurar ebay-browse como fuente real sin ellas
# falla al arrancar en vez de fallar a mitad de una investigación.
#
# AVISO (ADR 0015 §5): mientras no se resuelva si la API Browse entra en las
# "Restricted APIs" de eBay, sus señales se leen pero NO se guardan ni puntúan.
# Configurarla hoy no rompe nada y tampoco aporta datos utilizables.
EBAY__CLIENT_ID=
EBAY__CLIENT_SECRET=
# false apunta al entorno de pruebas de eBay (api.sandbox.ebay.com).
EBAY__USE_PRODUCTION=true
EBAY__MAX_REQUESTS=8
EBAY__TIMEOUT_SECONDS=6.0

# --- Gasto autorizado en APIs externas (Milestone 37, plan maestro §25) ---
# Lo que TÚ has autorizado gastar, por proveedor. Vacío significa que no hay
# autorización, y un proveedor de pago sin autorización NO SE LLAMA. Las dos
# fuentes de hoy son gratuitas, así que no hace falta nada aquí.
# Ejemplo (no activo):
#   API_SPEND_LIMITS={"un-proveedor":{"currency":"EUR","max_cost_per_day":5.0}}
API_SPEND_LIMITS={}
